{
  "name": "openasstai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13 <23"
  },
  "scripts": {
    "dev": "concurrently \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --no-warnings=ExperimentalWarning server/index.js",
    "dev:api:watch": "node --watch --no-warnings=ExperimentalWarning server/index.js",
    "dev:web": "vite --host 127.0.0.1 --port 5173",
    "build": "vite build",
    "start": "NODE_ENV=production node --no-warnings=ExperimentalWarning server/index.js",
    "db:migrate": "node --no-warnings=ExperimentalWarning server/scripts/migrate.js",
    "db:seed": "node --no-warnings=ExperimentalWarning server/scripts/seed.js",
    "smoke": "node --no-warnings=ExperimentalWarning server/scripts/smoke.js",
    "phase1:smoke": "node --no-warnings=ExperimentalWarning server/scripts/phase1-smoke.js"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "bcryptjs": "^3.0.3",
    "concurrently": "^9.2.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.556.0",
    "node-pty": "^1.1.0",
    "pg": "^8.21.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "vite": "^7.2.4",
    "ws": "^8.18.3"
  }
}
