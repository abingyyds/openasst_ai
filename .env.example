PORT=4000
HOST=127.0.0.1
PUBLIC_BASE_URL=http://127.0.0.1:4000
JWT_SECRET=replace-with-a-long-random-secret
SECRET_KEY=replace-with-a-32-byte-or-longer-secret
BOOTSTRAP_ADMIN_EMAIL=admin@openasst.ai
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-admin-password
SEED_DEMO_USER=true
DEMO_EMAIL=demo@openasst.ai
DEMO_PASSWORD=demo123

# Railway/Postgres production storage. Leave DATABASE_URL empty for local SQLite.
DATABASE_URL=
DATABASE_SSL=false

DATABASE_PATH=./data/openasstai.sqlite
RUNTIME_WORKSPACE_DIR=./runtime/workspaces
